<div class="zft-tp-wrapper">
  <div class="zft-tp-cell zft-tp-drag-handle" data-drag-handle data-tooltip="{{poolTooltip}}" data-tooltip-direction="LEFT">
    <i class="fa-solid fa-hourglass-half"></i>
  </div>
  <div class="zft-tp-cell">
    <button type="button" class="ui-control fa-solid {{toggleIcon}} icon" data-action="toggle" data-tooltip="{{toggleTooltip}}" data-tooltip-direction="LEFT" aria-label="Toggle Tension Pool"></button>
  </div>

  {{#if isGM}}
    <div class="zft-tp-cell">
      <button type="button" class="ui-control fa-solid fa-plus icon" data-action="addTime" data-tooltip="Add Tension: Time-Consuming Action" data-tooltip-direction="LEFT" aria-label="Add Tension"></button>
    </div>
    <div class="zft-tp-cell">
      <button type="button" class="ui-control fa-solid fa-minus icon" data-action="remove" data-tooltip="Remove 1 Tension" data-tooltip-direction="LEFT" aria-label="Remove Tension"></button>
    </div>
  {{/if}}

  {{#if collapsed}}
    <div class="zft-tp-compact-icons" data-tooltip="{{poolTooltip}}">
      <i class="{{compactIcon}}"></i>
      <span class="zft-tp-compact-count">{{state.diceCount}}</span>
    </div>
  {{else}}
    <div class="zft-tp-icons" data-tooltip="{{poolTooltip}}">
      {{#each icons}}
        <i class="{{class}}"></i>
      {{/each}}
    </div>
  {{/if}}

  {{#unless collapsed}}
    {{#if isGM}}
      <div class="zft-tp-cell">
        <button type="button" class="ui-control fa-solid fa-dice icon" data-action="risk" data-tooltip="Roll Risk: Reckless Action (Pool Remains)" data-tooltip-direction="RIGHT" aria-label="Roll Risk"></button>
      </div>
      <div class="zft-tp-cell">
        <button type="button" class="ui-control fa-solid fa-bolt icon" data-action="timeRisk" data-tooltip="Time + Risk: Add 1, Then Roll" data-tooltip-direction="RIGHT" aria-label="Time and Risk"></button>
      </div>
      <div class="zft-tp-cell">
        <button type="button" class="ui-control fa-solid fa-layer-plus icon" data-action="custom" data-tooltip="Add Multiple Tension Dice" data-tooltip-direction="RIGHT" aria-label="Add Multiple Tension Dice"></button>
      </div>
      <div class="zft-tp-cell">
        <button type="button" class="ui-control fa-solid fa-dice-d20 icon" data-action="breakPool" data-tooltip="Roll & Clear Pool" data-tooltip-direction="RIGHT" aria-label="Roll and Clear Pool"></button>
      </div>
      <div class="zft-tp-cell zft-tp-config-cell">
        <button type="button" class="ui-control fa-solid fa-gear icon" data-action="configure" data-tooltip="Tension Pool Settings" data-tooltip-direction="RIGHT" aria-label="Tension Pool Settings"></button>
      </div>
    {{/if}}
  {{/unless}}
</div>
